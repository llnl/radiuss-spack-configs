// SPDX-License-Identifier: MIT
digraph developer_loop {
  rankdir=TB;
  spec [label="Specification\ncompiler, variants, dependencies", shape=tab, fillcolor="#eee8f5"];
  prepare [label="Run Uberenv / Spack\nprepare dependencies", shape=box, style="rounded,filled", fillcolor="#e1f2e8"];
  host [label="Generated host configuration\n.cmake", shape=parallelogram, fillcolor="#dcf2f4"];
  configure [label="Configure CMake\nselect host configuration", shape=box, style="rounded,filled", fillcolor="#e1f2e8"];
  build [label="Build and test\nCMake / CTest", shape=box, style="rounded,filled", fillcolor="#e1f2e8"];
  edit [label="Edit project source", shape=box, style="rounded,filled", fillcolor="#e1f2e8"];
  spec -> prepare -> host -> configure -> build;
  build -> edit [label="next source change"];
  edit -> build [label="repeat"];
  build -> spec [label="recipe / dependency /\ntoolchain change", constraint=false];
}
