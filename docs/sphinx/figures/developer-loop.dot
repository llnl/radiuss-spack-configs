// SPDX-License-Identifier: MIT
digraph developer_loop {
  rankdir=TB;
  spec [
    label=<Specification<BR/><FONT POINT-SIZE="10"><I>compiler, variants, dependencies</I></FONT>>,
    shape=tab,
    fillcolor="#eee8f5"
  ];
  prepare [
    label=<Run rad-bat spack<BR/><FONT POINT-SIZE="10"><I>concretize spec and install dependencies</I></FONT>>,
    shape=box,
    style="rounded,filled",
    fillcolor="#e1f2e8"
  ];
  host [
    label=<Generated host configuration<BR/><FONT POINT-SIZE="10"><I>.cmake</I></FONT>>,
    shape=parallelogram,
    fillcolor="#dcf2f4"
  ];
  configure [
    label=<Configure CMake<BR/><FONT POINT-SIZE="10"><I>select host configuration</I></FONT>>,
    shape=box,
    style="rounded,filled",
    fillcolor="#e1f2e8"
  ];
  build [
    label=<Build and test<BR/><FONT POINT-SIZE="10"><I>CMake / CTest</I></FONT>>,
    shape=box,
    style="rounded,filled",
    fillcolor="#e1f2e8"
  ];
  edit [label="Edit project source", shape=box, style="rounded,filled", fillcolor="#e1f2e8"];
  spec -> prepare -> host -> configure -> build;
  build -> edit [label="next source change"];
  edit -> build [label="repeat"];
  build -> spec [label="recipe / dependency /\ntoolchain change", constraint=false];
}
