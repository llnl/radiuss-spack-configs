// SPDX-License-Identifier: MIT
digraph rad_bat_modes {
  rankdir=TB;
  inputs [label="Job or command inputs\nSPEC / host-config selector", shape=tab, fillcolor="#eee8f5"];
  select [label="rad-bat\nselect explicit workflow", shape=box, style="rounded,filled", fillcolor="#e1f2e8"];
  maintained [label="Maintained host configuration\n.cmake", shape=parallelogram, fillcolor="#dcf2f4"];
  spack [label="Pinned native Spack\nconcretize and install dependencies", shape=box, style="rounded,filled", fillcolor="#e1f2e8"];
  generated [label="Generated host configuration\n.cmake artifact", shape=parallelogram, fillcolor="#dcf2f4"];
  driver [label="Project build/test driver", shape=box, style="rounded,filled", fillcolor="#e1f2e8"];
  inputs -> select;
  select -> maintained [label="host-config mode"];
  select -> spack [label="spack mode"];
  spack -> generated;
  maintained -> driver;
  generated -> driver;
}
