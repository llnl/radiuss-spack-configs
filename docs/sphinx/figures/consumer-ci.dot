// SPDX-License-Identifier: MIT
digraph consumer_ci {
  rankdir=TB;
  shared [
    label=<RADIUSS Spack Configs<BR/><FONT POINT-SIZE="10"><I>shared SPEC jobs</I></FONT>>,
    shape=folder,
    fillcolor="#e3edf7"
  ];
  project [
    label=<RAJA<BR/><FONT POINT-SIZE="10"><I>variables, jobs, build/test driver</I></FONT>>,
    shape=folder,
    fillcolor="#e3edf7"
  ];
  ci [
    label=<RADIUSS Shared CI<BR/><FONT POINT-SIZE="10"><I>machine components</I></FONT>>,
    shape=folder,
    fillcolor="#e3edf7"
  ];
  pin [label="component revision", shape=box, fontsize=10, margin="0.08,0.04", fillcolor="#f7e4e4"];
  compose [
    label=<Compose child pipeline<BR/><FONT POINT-SIZE="10"><I>shared jobs then project overrides</I></FONT>>,
    shape=box,
    style="rounded,filled",
    fillcolor="#e1f2e8"
  ];
  pipeline [label="Generated child pipeline", shape=parallelogram, fillcolor="#dcf2f4"];
  execute [
    label=<Execute project driver<BR/><FONT POINT-SIZE="10"><I>SPEC → prepare → build → test</I></FONT>>,
    shape=box,
    style="rounded,filled",
    fillcolor="#e1f2e8"
  ];
  shared -> compose [style=dashed, arrowhead=empty, label="shared jobs"];
  project -> compose [style=dashed, arrowhead=empty, label="project settings"];
  ci -> pin [style=dashed, arrowhead=empty, label="available versions"];
  pin -> compose [style=dotted, arrowhead=vee, color="#874e69", label="adopt revision"];
  compose -> pipeline -> execute;
}
