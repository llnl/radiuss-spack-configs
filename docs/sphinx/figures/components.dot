digraph components {
  rankdir=TB;
  project [label=<RAJA<BR/><FONT POINT-SIZE="10"><I>project source and tests</I></FONT>>, shape=folder, fillcolor="#e3edf7"];
  settings [label=<.rad-bat.json<BR/><FONT POINT-SIZE="10"><I>select tools and recipes</I></FONT>>, shape=tab, fillcolor="#eee8f5"];
  spack [label=<spack/spack<BR/><FONT POINT-SIZE="10"><I>package manager</I></FONT>>, shape=folder, fillcolor="#e3edf7"];
  recipes [label=<spack/spack-packages<BR/><FONT POINT-SIZE="10"><I>upstream recipes</I></FONT>>, shape=folder, fillcolor="#e3edf7"];
  recipe [label=<package.py<BR/><FONT POINT-SIZE="10"><I>versions and build behavior</I></FONT>>, shape=note, fillcolor="#fff2cf"];
  configs [label=<RADIUSS Spack Configs<BR/><FONT POINT-SIZE="10"><I>machines and shared specs</I></FONT>>, shape=folder, fillcolor="#e3edf7"];
  machine [label=<packages.yaml / spack.yaml<BR/><FONT POINT-SIZE="10"><I>selected machine configuration</I></FONT>>, shape=tab, fillcolor="#eee8f5"];
  radbat [label=<rad-bat<BR/><FONT POINT-SIZE="10"><I>select or prepare dependencies</I></FONT>>, shape=box, style="rounded,filled", fillcolor="#e1f2e8"];
  host [label=<Generated host configuration<BR/><FONT POINT-SIZE="10"><I>.cmake</I></FONT>>, shape=parallelogram, fillcolor="#dcf2f4"];
  project -> settings [style=dashed, arrowhead=empty, label="owns"];
  settings -> radbat [style=dashed, arrowhead=empty, label="configures"];
  recipes -> recipe [style=dashed, arrowhead=empty, label="provides"];
  configs -> machine [style=dashed, arrowhead=empty, label="provides"];
  spack -> radbat [style=dashed, arrowhead=empty, label="concretizes and installs"];
  recipe -> radbat [style=dashed, arrowhead=empty, label="recipe input"];
  machine -> radbat [style=dashed, arrowhead=empty, label="machine input"];
  radbat -> host [label="selects or runs initconfig"];
}
